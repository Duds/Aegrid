generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                          String                       @id @default(cuid())
  name                        String                       @unique
  resilienceConfig            Json?
  resourceSettings            Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  assets                      Asset[]
  assetCriticalControls       AssetCriticalControl[]
  auditLogs                   AuditLog[]
  citizenFeedback             CitizenFeedback[]
  citizenReports              CitizenReport[]
  complianceRecords           ComplianceRecord[]
  contracts                   Contract[]
  criticalControls            CriticalControl[]
  emergencyAlerts             EmergencyAlert[]
  emergencyResources          EmergencyResource[]
  emergencyResponses          EmergencyResponse[]
  energyAlerts                EnergyAlert[]
  energySystems               EnergySystem[]
  environmentalSignals        EnvironmentalSignal[]
  escalationEvents            EscalationEvent[]
  inspectionPhotos            InspectionPhoto[]
  invitations                 Invitation[]
  performanceAlerts           PerformanceAlert[]
  performanceKPIs             PerformanceKPI[]
  rcmTemplates                RCMTemplate[]
  marginCapacities            ResourceCapacity[]
  riskSignals                 RiskSignal[]
  slas                        SLA[]
  users                       User[]
  vendors                     Vendor[]
  workOrderEvidence           WorkOrderEvidence[]
  workOrderParts              WorkOrderPart[]
  workOrderSafetyRequirements WorkOrderSafetyRequirement[]
  workOrderSkills             WorkOrderSkill[]
  workOrderTypes              WorkOrderType[]
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  name                    String?
  passwordHash            String?
  role                    Role                @default(CITIZEN)
  organisationId          String?
  vendorId                String?
  emailVerified           DateTime?
  image                   String?
  isActive                Boolean             @default(true)
  lastLoginAt             DateTime?
  passwordResetAt         DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  mfaEnabled              Boolean             @default(false)
  mfaSecret               String?
  mfaBackupCodes          String[]            @default([])
  mfaVerifiedAt           DateTime?
  phoneNumber             String?
  bio                     String?
  timezone                String              @default("Australia/Sydney")
  language                String              @default("en-AU")
  notificationPreferences Json                @default("{}")
  accounts                Account[]
  assetsCreated           Asset[]             @relation("AssetCreatedBy")
  assetsUpdated           Asset[]             @relation("AssetUpdatedBy")
  assetDocuments          AssetDocument[]
  assetInspections        AssetInspection[]
  assetMaintenance        AssetMaintenance[]
  auditLogs               AuditLog[]
  citizenFeedback         CitizenFeedback[]
  citizenReports          CitizenReport[]
  complianceRecords       ComplianceRecord[]
  emergencyResponses      EmergencyResponse[]
  escalationEvents        EscalationEvent[]
  inspections             Inspection[]
  inspectionPhotos        InspectionPhoto[]
  invitationsSent         Invitation[]        @relation("InvitedBy")
  rcmTemplatesCreated     RCMTemplate[]       @relation("RCMTemplateCreatedBy")
  riskSignals             RiskSignal[]
  sessions                Session[]
  organisation            Organisation?       @relation(fields: [organisationId], references: [id])
  vendor                  Vendor?             @relation(fields: [vendorId], references: [id])
  workOrdersCreated       WorkOrder[]         @relation("WorkOrderAssignedBy")
  workOrdersAssigned      WorkOrder[]
  workOrderEvidence       WorkOrderEvidence[]
}

model Vendor {
  id                    String                 @id @default(cuid())
  organisationId        String
  name                  String
  abn                   String?
  contactEmail          String
  contactPhone          String?
  performanceRating     Decimal?               @db.Decimal(3, 2)
  capacityMargin        Int?                   @default(20)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assetCriticalControls AssetCriticalControl[]
  contracts             Contract[]
  users                 User[]
  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  workOrders            WorkOrder[]

  @@index([organisationId])
  @@index([performanceRating])
}

model Contract {
  id             String       @id @default(cuid())
  organisationId String
  vendorId       String
  name           String
  startDate      DateTime
  endDate        DateTime
  scope          String
  status         String       @default("ACTIVE")
  renewalDueDate DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  slas           SLA[]
  workOrders     WorkOrder[]

  @@index([organisationId])
  @@index([vendorId])
  @@index([status])
}

model SLA {
  id                  String       @id @default(cuid())
  organisationId      String
  contractId          String
  name                String
  responseTimeHours   Int
  resolutionTimeHours Int
  frequencyDays       Int?
  costModel           String
  breachEscalation    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  contract            Contract     @relation(fields: [contractId], references: [id])
  organisation        Organisation @relation(fields: [organisationId], references: [id])
  workOrders          WorkOrder[]

  @@index([organisationId])
  @@index([contractId])
}

model Asset {
  id                    String                   @id @default(cuid())
  organisationId        String
  assetNumber           String                   @unique
  name                  String
  description           String?
  assetType             AssetType
  status                AssetStatus              @default(ACTIVE)
  condition             AssetCondition           @default(UNKNOWN)
  priority              AssetPriority            @default(MEDIUM)
  purpose               String?
  purposeDescription    String?
  criticalityLevel      String?
  serviceImpact         String?
  functionBasedCategory String?
  location              Unsupported("geometry")?
  address               String?
  suburb                String?
  postcode              String?
  state                 String                   @default("NSW")
  country               String                   @default("Australia")
  manufacturer          String?
  model                 String?
  serialNumber          String?
  installationDate      DateTime?
  warrantyExpiry        DateTime?
  expectedLifespan      Int?
  purchasePrice         Decimal?                 @db.Decimal(12, 2)
  currentValue          Decimal?                 @db.Decimal(12, 2)
  replacementCost       Decimal?                 @db.Decimal(12, 2)
  depreciationRate      Decimal?                 @db.Decimal(5, 2)
  lastInspection        DateTime?
  nextInspection        DateTime?
  inspectionFrequency   Int?
  maintenanceCost       Decimal?                 @db.Decimal(12, 2)
  tags                  String[]                 @default([])
  notes                 String?
  isPublic              Boolean                  @default(false)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  createdByUser         User?                    @relation("AssetCreatedBy", fields: [createdBy], references: [id])
  organisation          Organisation             @relation(fields: [organisationId], references: [id])
  updatedByUser         User?                    @relation("AssetUpdatedBy", fields: [updatedBy], references: [id])
  assetCriticalControls AssetCriticalControl[]
  documents             AssetDocument[]
  inspections           AssetInspection[]
  maintenance           AssetMaintenance[]
  rcmTemplates          AssetRCMTemplate[]
  auditLogs             AuditLog[]
  citizenReports        CitizenReport[]
  complianceRecords     ComplianceRecord[]
  emergencyAlerts       EmergencyAlert[]
  emergencyResponses    EmergencyResponse[]
  energySystems         EnergySystem[]
  escalationEvents      EscalationEvent[]
  inspections2          Inspection[]
  maintenanceSchedules  MaintenanceSchedule[]
  riskSignals           RiskSignal[]
  workOrders            WorkOrder[]

  @@index([organisationId])
  @@index([assetNumber])
  @@index([assetType])
  @@index([status])
  @@index([condition])
  @@index([priority])
  @@index([location])
  @@index([createdAt])
}

model WorkOrder {
  id                      String                   @id @default(cuid())
  assetId                 String
  workOrderNumber         String                   @unique
  title                   String
  description             String
  priority                AssetPriority            @default(MEDIUM)
  status                  String                   @default("OPEN")
  assignedTo              String?
  assignedBy              String?
  vendorId                String?
  contractId              String?
  slaId                   String?
  scheduledDate           DateTime?
  dueDate                 DateTime?
  completedDate           DateTime?
  acceptedAt              DateTime?
  acknowledgedAt          DateTime?
  startedAt               DateTime?
  slaResponseTime         Int?
  slaResolutionTime       Int?
  slaStatus               String?
  declineReason           String?
  estimatedCost           Decimal?                 @db.Decimal(12, 2)
  actualCost              Decimal?                 @db.Decimal(12, 2)
  estimatedDuration       Int?
  actualDuration          Int?
  workPerformed           String?
  notes                   String?
  evidenceCount           Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  citizenFeedback         CitizenFeedback[]
  citizenReports          CitizenReport[]
  emergencyResponse       EmergencyResponse[]
  escalationEvents        EscalationEvent[]
  inspections             Inspection[]
  asset                   Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedByUser          User?                    @relation("WorkOrderAssignedBy", fields: [assignedBy], references: [id])
  assignedToUser          User?                    @relation(fields: [assignedTo], references: [id])
  contract                Contract?                @relation(fields: [contractId], references: [id])
  sla                     SLA?                     @relation(fields: [slaId], references: [id])
  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id])
  evidence                WorkOrderEvidence[]
  workOrderPartMappings   WorkOrderPartMapping[]
  workOrderSafetyMappings WorkOrderSafetyMapping[]
  workOrderSkillMappings  WorkOrderSkillMapping[]
  workOrderTypeMappings   WorkOrderTypeMapping[]

  @@index([assetId])
  @@index([workOrderNumber])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([slaStatus])
}

model CriticalControl {
  id                String                 @id @default(cuid())
  organisationId    String
  name              String
  description       String?
  type              String
  windowHours       Int
  frequencyDays     Int
  escalationPolicy  String?
  status            String                 @default("ACTIVE")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  assetMappings     AssetCriticalControl[]
  complianceRecords ComplianceRecord[]
  organisation      Organisation           @relation(fields: [organisationId], references: [id])
  escalationEvents  EscalationEvent[]

  @@index([organisationId])
  @@index([type])
  @@index([status])
}

model AssetCriticalControl {
  id                String          @id @default(cuid())
  organisationId    String
  assetId           String
  criticalControlId String
  vendorId          String?
  lastExecutedAt    DateTime?
  nextDueAt         DateTime?
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  asset             Asset           @relation(fields: [assetId], references: [id])
  criticalControl   CriticalControl @relation(fields: [criticalControlId], references: [id])
  organisation      Organisation    @relation(fields: [organisationId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])

  @@unique([assetId, criticalControlId])
  @@index([organisationId])
  @@index([assetId])
  @@index([criticalControlId])
}

model CitizenReport {
  id             String                   @id @default(cuid())
  organisationId String
  assetId        String?
  workOrderId    String?
  reportedBy     String?
  reporterName   String
  reporterEmail  String
  reporterPhone  String?
  issueCategory  String
  riskLevel      String
  description    String
  location       Unsupported("geometry")?
  status         String                   @default("OPEN")
  reportedAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  feedback       CitizenFeedback[]
  asset          Asset?                   @relation(fields: [assetId], references: [id])
  organisation   Organisation             @relation(fields: [organisationId], references: [id])
  reportedByUser User?                    @relation(fields: [reportedBy], references: [id])
  workOrder      WorkOrder?               @relation(fields: [workOrderId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([issueCategory])
  @@index([riskLevel])
  @@index([status])
}

model CitizenFeedback {
  id                 String         @id @default(cuid())
  organisationId     String
  citizenReportId    String?
  workOrderId        String?
  submittedBy        String?
  satisfactionRating Int
  feedbackText       String?
  serviceImprovement String?
  submittedAt        DateTime       @default(now())
  createdAt          DateTime       @default(now())
  citizenReport      CitizenReport? @relation(fields: [citizenReportId], references: [id])
  organisation       Organisation   @relation(fields: [organisationId], references: [id])
  submittedByUser    User?          @relation(fields: [submittedBy], references: [id])
  workOrder          WorkOrder?     @relation(fields: [workOrderId], references: [id])

  @@index([organisationId])
  @@index([citizenReportId])
  @@index([workOrderId])
  @@index([satisfactionRating])
}

model RiskSignal {
  id             String       @id @default(cuid())
  organisationId String
  assetId        String?
  detectedBy     String?
  signalType     String
  severity       String
  description    String
  source         String
  detectedAt     DateTime
  resolvedAt     DateTime?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())
  asset          Asset?       @relation(fields: [assetId], references: [id])
  detectedByUser User?        @relation(fields: [detectedBy], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([signalType])
  @@index([severity])
  @@index([detectedAt])
}

model EnvironmentalSignal {
  id             String                   @id @default(cuid())
  organisationId String
  signalType     String
  severity       String
  description    String
  location       Unsupported("geometry")?
  detectedAt     DateTime
  expiresAt      DateTime?
  status         String                   @default("ACTIVE")
  createdAt      DateTime                 @default(now())
  organisation   Organisation             @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([signalType])
  @@index([severity])
  @@index([detectedAt])
}

model ResourceCapacity {
  id                String       @id @default(cuid())
  organisationId    String
  capacityType      String
  availableCapacity Int
  utilisedCapacity  Int
  marginPercentage  Decimal      @db.Decimal(5, 2)
  lastUpdatedAt     DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organisation      Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([capacityType])
}

model EmergencyResponse {
  id                    String       @id @default(cuid())
  organisationId        String
  assetId               String?
  workOrderId           String?
  activatedBy           String?
  emergencyType         String
  severity              String
  responseTimeMinutes   Int
  resolutionTimeMinutes Int
  marginDeployed        Boolean      @default(false)
  activatedAt           DateTime
  resolvedAt            DateTime?
  createdAt             DateTime     @default(now())
  activatedByUser       User?        @relation(fields: [activatedBy], references: [id])
  asset                 Asset?       @relation(fields: [assetId], references: [id])
  organisation          Organisation @relation(fields: [organisationId], references: [id])
  workOrder             WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([emergencyType])
  @@index([severity])
  @@index([activatedAt])
}

model ComplianceRecord {
  id                String           @id @default(cuid())
  organisationId    String
  assetId           String?
  criticalControlId String?
  assignedTo        String?
  complianceType    String
  status            String
  dueDate           DateTime?
  completedDate     DateTime?
  evidenceCount     Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  asset             Asset?           @relation(fields: [assetId], references: [id])
  assignedToUser    User?            @relation(fields: [assignedTo], references: [id])
  criticalControl   CriticalControl? @relation(fields: [criticalControlId], references: [id])
  organisation      Organisation     @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([criticalControlId])
  @@index([complianceType])
  @@index([status])
}

model EscalationEvent {
  id                String           @id @default(cuid())
  organisationId    String
  assetId           String?
  criticalControlId String?
  workOrderId       String?
  escalatedBy       String?
  escalationType    String
  severity          String
  reason            String
  escalatedTo       String
  escalatedAt       DateTime
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  asset             Asset?           @relation(fields: [assetId], references: [id])
  criticalControl   CriticalControl? @relation(fields: [criticalControlId], references: [id])
  escalatedByUser   User?            @relation(fields: [escalatedBy], references: [id])
  organisation      Organisation     @relation(fields: [organisationId], references: [id])
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([criticalControlId])
  @@index([workOrderId])
  @@index([escalationType])
  @@index([severity])
  @@index([escalatedAt])
}

model WorkOrderEvidence {
  id             String                   @id @default(cuid())
  organisationId String
  workOrderId    String
  uploadedBy     String?
  evidenceType   String
  filePath       String
  fileName       String
  fileSize       Int
  gpsCoordinates Unsupported("geometry")?
  uploadedAt     DateTime
  createdAt      DateTime                 @default(now())
  organisation   Organisation             @relation(fields: [organisationId], references: [id])
  uploadedByUser User?                    @relation(fields: [uploadedBy], references: [id])
  workOrder      WorkOrder                @relation(fields: [workOrderId], references: [id])

  @@index([organisationId])
  @@index([workOrderId])
  @@index([evidenceType])
  @@index([uploadedAt])
}

model InspectionPhoto {
  id             String                   @id @default(cuid())
  organisationId String
  inspectionId   String
  uploadedBy     String?
  filePath       String
  fileName       String
  gpsCoordinates Unsupported("geometry")?
  description    String?
  uploadedAt     DateTime
  createdAt      DateTime                 @default(now())
  inspection     Inspection               @relation(fields: [inspectionId], references: [id])
  organisation   Organisation             @relation(fields: [organisationId], references: [id])
  uploadedByUser User?                    @relation(fields: [uploadedBy], references: [id])

  @@index([organisationId])
  @@index([inspectionId])
  @@index([uploadedAt])
}

model Inspection {
  id                 String            @id @default(cuid())
  assetId            String
  inspectionDate     DateTime
  inspectorName      String
  inspectorId        String?
  workOrderId        String?
  condition          AssetCondition
  conditionNotes     String?
  riskScore          Int?
  issues             String[]          @default([])
  recommendations    String?
  nextInspectionDate DateTime?
  priorityActions    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  asset              Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspector          User?             @relation(fields: [inspectorId], references: [id])
  workOrder          WorkOrder?        @relation(fields: [workOrderId], references: [id])
  photos             InspectionPhoto[]

  @@index([assetId])
  @@index([inspectionDate])
  @@index([condition])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  location     String?
  isActive     Boolean  @default(true)
  lastUsed     DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id             String        @id @default(cuid())
  action         AuditAction
  userId         String?
  organisationId String?
  assetId        String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  asset          Asset?        @relation(fields: [assetId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organisationId])
  @@index([assetId])
  @@index([action])
  @@index([createdAt])
}

model AssetDocument {
  id             String   @id @default(cuid())
  assetId        String
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  filePath       String
  description    String?
  documentType   String
  uploadedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedByUser User?    @relation(fields: [uploadedBy], references: [id])

  @@index([assetId])
  @@index([documentType])
  @@index([createdAt])
}

model AssetInspection {
  id                 String         @id @default(cuid())
  assetId            String
  inspectionDate     DateTime
  inspectorName      String
  inspectorId        String?
  condition          AssetCondition
  conditionNotes     String?
  issues             String[]       @default([])
  recommendations    String?
  nextInspectionDate DateTime?
  priorityActions    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspector          User?          @relation(fields: [inspectorId], references: [id])

  @@index([assetId])
  @@index([inspectionDate])
  @@index([condition])
}

model AssetMaintenance {
  id              String   @id @default(cuid())
  assetId         String
  maintenanceDate DateTime
  maintenanceType String
  description     String
  performedBy     String?
  cost            Decimal? @db.Decimal(12, 2)
  duration        Int?
  materials       String?
  issuesFound     String?
  workPerformed   String?
  recommendations String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedByUser User?    @relation(fields: [performedBy], references: [id])

  @@index([assetId])
  @@index([maintenanceDate])
  @@index([maintenanceType])
}

model EmergencyAlert {
  id             String       @id @default(cuid())
  organisationId String
  assetId        String?
  alertType      String
  severity       String
  title          String
  description    String
  location       String?
  status         String       @default("ACTIVE")
  responseTime   Int?
  resolutionTime Int?
  detectedAt     DateTime     @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  asset          Asset?       @relation(fields: [assetId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

model EmergencyResource {
  id             String       @id @default(cuid())
  organisationId String
  resourceType   String
  name           String
  description    String?
  totalCapacity  Int
  availableCount Int
  utilisedCount  Int          @default(0)
  status         String
  location       String?
  contactPerson  String?
  contactPhone   String?
  contactEmail   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([resourceType])
  @@index([status])
}

model EnergySystem {
  id              String        @id @default(cuid())
  organisationId  String
  assetId         String?
  name            String
  systemType      String
  status          String
  capacity        Decimal       @db.Decimal(10, 2)
  currentOutput   Decimal       @db.Decimal(10, 2)
  efficiency      Decimal       @db.Decimal(5, 2)
  location        String?
  gridConnection  Boolean       @default(false)
  batteryLevel    Decimal?      @db.Decimal(5, 2)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  energyAlerts    EnergyAlert[]
  asset           Asset?        @relation(fields: [assetId], references: [id])
  organisation    Organisation  @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([assetId])
  @@index([systemType])
  @@index([status])
}

model EnergyAlert {
  id             String       @id @default(cuid())
  organisationId String
  energySystemId String
  alertType      String
  severity       String
  message        String
  description    String?
  status         String       @default("ACTIVE")
  detectedAt     DateTime     @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  energySystem   EnergySystem @relation(fields: [energySystemId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([energySystemId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

model PerformanceKPI {
  id                String             @id @default(cuid())
  organisationId    String
  name              String
  description       String?
  category          String
  currentValue      Decimal            @db.Decimal(10, 2)
  targetValue       Decimal            @db.Decimal(10, 2)
  unit              String
  trend             String
  changePercent     Decimal            @db.Decimal(5, 2)
  status            String
  period            String
  measuredAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  performanceAlerts PerformanceAlert[]
  organisation      Organisation       @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([category])
  @@index([status])
  @@index([measuredAt])
}

model PerformanceAlert {
  id             String          @id @default(cuid())
  organisationId String
  kpiId          String?
  alertType      String
  severity       String
  title          String
  description    String
  thresholdValue Decimal?        @db.Decimal(10, 2)
  actualValue    Decimal         @db.Decimal(10, 2)
  status         String          @default("ACTIVE")
  detectedAt     DateTime        @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  kpi            PerformanceKPI? @relation(fields: [kpiId], references: [id])
  organisation   Organisation    @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([kpiId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

model WorkOrderType {
  id                    String                 @id @default(cuid())
  organisationId        String
  name                  String
  description           String?
  category              String
  defaultPriority       AssetPriority          @default(MEDIUM)
  estimatedDuration     Int?
  requiresApproval      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  workOrderTypeMappings WorkOrderTypeMapping[]

  @@index([organisationId])
  @@index([category])
}

model WorkOrderSkill {
  id                     String                  @id @default(cuid())
  organisationId         String
  name                   String
  description            String?
  category               String
  skillLevel             String?
  certificationRequired  Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  workOrderSkillMappings WorkOrderSkillMapping[]

  @@index([organisationId])
  @@index([category])
}

model WorkOrderPart {
  id                    String                 @id @default(cuid())
  organisationId        String
  partNumber            String
  name                  String
  description           String?
  category              String
  currentStock          Int                    @default(0)
  minimumStock          Int                    @default(0)
  unitCost              Decimal?               @db.Decimal(10, 2)
  supplier              String?
  supplierPartNumber    String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  workOrderPartMappings WorkOrderPartMapping[]

  @@index([organisationId])
  @@index([partNumber])
  @@index([category])
}

model WorkOrderSafetyRequirement {
  id                      String                   @id @default(cuid())
  organisationId          String
  name                    String
  description             String?
  category                String
  isMandatory             Boolean                  @default(true)
  requiresPermit          Boolean                  @default(false)
  requiresTraining        Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  workOrderSafetyMappings WorkOrderSafetyMapping[]
  organisation            Organisation             @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([category])
}

model WorkOrderTypeMapping {
  id              String        @id @default(cuid())
  workOrderId     String
  workOrderTypeId String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id])
  workOrderType   WorkOrderType @relation(fields: [workOrderTypeId], references: [id])

  @@unique([workOrderId, workOrderTypeId])
  @@index([workOrderId])
  @@index([workOrderTypeId])
}

model WorkOrderSkillMapping {
  id               String         @id @default(cuid())
  workOrderId      String
  workOrderSkillId String
  workOrder        WorkOrder      @relation(fields: [workOrderId], references: [id])
  workOrderSkill   WorkOrderSkill @relation(fields: [workOrderSkillId], references: [id])

  @@unique([workOrderId, workOrderSkillId])
  @@index([workOrderId])
  @@index([workOrderSkillId])
}

model WorkOrderPartMapping {
  id               String        @id @default(cuid())
  workOrderId      String
  workOrderPartId  String
  quantityRequired Int           @default(1)
  quantityUsed     Int           @default(0)
  workOrder        WorkOrder     @relation(fields: [workOrderId], references: [id])
  workOrderPart    WorkOrderPart @relation(fields: [workOrderPartId], references: [id])

  @@unique([workOrderId, workOrderPartId])
  @@index([workOrderId])
  @@index([workOrderPartId])
}

model WorkOrderSafetyMapping {
  id                           String                     @id @default(cuid())
  workOrderId                  String
  workOrderSafetyRequirementId String
  isCompliant                  Boolean                    @default(false)
  complianceNotes              String?
  workOrder                    WorkOrder                  @relation(fields: [workOrderId], references: [id])
  workOrderSafetyRequirement   WorkOrderSafetyRequirement @relation(fields: [workOrderSafetyRequirementId], references: [id])

  @@unique([workOrderId, workOrderSafetyRequirementId])
  @@index([workOrderId])
  @@index([workOrderSafetyRequirementId])
}

model RCMTemplate {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  assetType           String
  version             String               @default("1.0")
  status              RCMTemplateStatus    @default(DRAFT)
  isPublic            Boolean              @default(false)
  createdBy           String
  organisationId      String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assetsUsingTemplate AssetRCMTemplate[]
  failureModes        RCMFailureMode[]
  maintenanceTasks    RCMMaintenanceTask[]
  createdByUser       User                 @relation("RCMTemplateCreatedBy", fields: [createdBy], references: [id])
  organisation        Organisation         @relation(fields: [organisationId], references: [id])

  @@index([assetType])
  @@index([status])
  @@index([createdBy])
  @@index([organisationId])
}

model RCMFailureMode {
  id               String                @id @default(cuid())
  templateId       String
  name             String
  description      String?
  type             FailureModeType
  cause            String?
  effect           String
  severity         FailureEffectSeverity
  consequences     String?
  detectionMethod  String?
  preventionMethod String?
  probability      Int?
  impact           Int?
  riskScore        Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  template         RCMTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([type])
  @@index([severity])
}

model RCMMaintenanceTask {
  id                 String               @id @default(cuid())
  templateId         String
  name               String
  description        String?
  type               MaintenanceTaskType
  frequency          MaintenanceFrequency
  duration           Int?
  skillLevel         String?
  tools              String?
  materials          String?
  instructions       String?
  safetyRequirements String?
  complianceNotes    String?
  estimatedCost      Decimal?             @db.Decimal(10, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  template           RCMTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([type])
  @@index([frequency])
}

model AssetRCMTemplate {
  id         String      @id @default(cuid())
  assetId    String
  templateId String
  isActive   Boolean     @default(true)
  lastReview DateTime?
  nextReview DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  template   RCMTemplate @relation(fields: [templateId], references: [id])

  @@unique([assetId, templateId])
  @@index([assetId])
  @@index([templateId])
  @@index([isActive])
}

model MaintenanceSchedule {
  id            String               @id @default(cuid())
  assetId       String
  templateId    String?
  taskName      String
  taskType      MaintenanceTaskType
  frequency     MaintenanceFrequency
  scheduledDate DateTime
  dueDate       DateTime
  completedDate DateTime?
  assignedTo    String?
  status        String               @default("PENDING")
  priority      AssetPriority        @default(MEDIUM)
  workPerformed String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  asset         Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([scheduledDate])
  @@index([dueDate])
  @@index([status])
  @@index([assignedTo])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           Role
  organisationId String
  invitedBy      String
  message        String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitedByUser  User             @relation("InvitedBy", fields: [invitedBy], references: [id])
  organisation   Organisation     @relation(fields: [organisationId], references: [id])

  @@unique([email, organisationId])
}

