  uploaded_at : timestamp
  created_at : timestamp
}

entity InspectionPhoto {
  * id : UUID
  --
  organisation_id : UUID
  inspection_id : UUID
  file_path : string
  file_name : string
  gps_coordinates : geometry
  description : text
  uploaded_at : timestamp
  created_at : timestamp
}

entity AssetDocument {
  * id : UUID
  --
  organisation_id : UUID
  asset_id : UUID
