  file_path : string
  file_name : string
  file_size : int
  description : text
  uploaded_at : timestamp
  created_at : timestamp
}

' Citizen Engagement
entity CitizenReport {
  * id : UUID
  --
  organisation_id : UUID
  asset_id : UUID
  work_order_id : UUID
  reporter_name : string
  reporter_email : string
  reporter_phone : string
  issue_category : string
  risk_level : string
