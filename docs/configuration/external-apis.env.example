# External API Configuration
# Copy this file to .env.local and configure your API keys and endpoints

# =============================================================================
# WEATHER SERVICES
# =============================================================================

# OpenWeatherMap API (https://openweathermap.org/api)
# Free tier: 1,000 calls/day, 60 calls/minute
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Alternative weather services (optional)
# WEATHER_API_KEY=your_weather_api_key_here
# ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# =============================================================================
# IOT SERVICES
# =============================================================================

# MQTT Broker Configuration
# Local broker: mqtt://localhost:1883
# Cloud brokers: mqtts://broker.hivemq.com:8883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Alternative IoT platforms (optional)
# AWS_IOT_ENDPOINT=your_aws_iot_endpoint
# AZURE_IOT_HUB_CONNECTION_STRING=your_azure_connection_string
# GOOGLE_CLOUD_IOT_PROJECT_ID=your_gcp_project_id

# =============================================================================
# ENERGY SERVICES
# =============================================================================

# OPC UA Server Configuration
# Local server: opc.tcp://localhost:4840
# Industrial servers: opc.tcp://your-server:4840
OPCUA_SERVER_URL=opc.tcp://localhost:4840
OPCUA_USERNAME=your_opcua_username
OPCUA_PASSWORD=your_opcua_password

# Energy Grid APIs (optional)
# AEMO_API_KEY=your_aemo_api_key
# ENERGY_API_KEY=your_energy_api_key
# ENERGY_API_URL=https://api.aemo.com.au

# =============================================================================
# EMERGENCY SERVICES
# =============================================================================

# Emergency Services API (optional)
# CAP (Common Alerting Protocol) compatible services
EMERGENCY_API_KEY=your_emergency_api_key
EMERGENCY_API_URL=https://api.emergency.gov.au

# Alternative emergency services
# FIRE_SERVICES_API_KEY=your_fire_services_key
# AMBULANCE_API_KEY=your_ambulance_key
# POLICE_API_KEY=your_police_key

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# API Security Settings
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=60

# SSL/TLS Configuration
EXTERNAL_API_SSL_VERIFY=true
EXTERNAL_API_SSL_CERT_PATH=/path/to/cert.pem

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# External API Monitoring
EXTERNAL_API_MONITORING_ENABLED=true
EXTERNAL_API_LOG_LEVEL=info
EXTERNAL_API_LOG_FILE=/var/log/aegrid/external-apis.log

# Health Check Configuration
EXTERNAL_API_HEALTH_CHECK_INTERVAL=300000
EXTERNAL_API_HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================

# Data Caching Settings
EXTERNAL_API_CACHE_ENABLED=true
EXTERNAL_API_CACHE_TTL=600000
EXTERNAL_API_CACHE_MAX_SIZE=1000

# Connection Pooling
EXTERNAL_API_CONNECTION_POOL_SIZE=10
EXTERNAL_API_CONNECTION_POOL_TIMEOUT=30000

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Development Mode Settings
EXTERNAL_API_DEV_MODE=false
EXTERNAL_API_MOCK_DATA=false
EXTERNAL_API_SIMULATION_FALLBACK=true

# Testing Configuration
EXTERNAL_API_TEST_TIMEOUT=5000
EXTERNAL_API_TEST_RETRY_ATTEMPTS=1

# =============================================================================
# REGIONAL CONFIGURATION
# =============================================================================

# Default Locations (Australia)
DEFAULT_WEATHER_LOCATIONS=Sydney,Melbourne,Brisbane
DEFAULT_TIMEZONE=Australia/Sydney
DEFAULT_CURRENCY=AUD
DEFAULT_UNITS=metric

# Regional API Endpoints
AUSTRALIA_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
AUSTRALIA_ENERGY_API_URL=https://api.aemo.com.au
AUSTRALIA_EMERGENCY_API_URL=https://api.emergency.gov.au

# =============================================================================
# BACKUP & REDUNDANCY
# =============================================================================

# Backup API Services
BACKUP_WEATHER_API_KEY=your_backup_weather_key
BACKUP_IOT_BROKER_URL=mqtt://backup-broker:1883
BACKUP_ENERGY_API_URL=opc.tcp://backup-server:4840

# Failover Configuration
EXTERNAL_API_FAILOVER_ENABLED=true
EXTERNAL_API_FAILOVER_TIMEOUT=5000
EXTERNAL_API_FAILOVER_RETRY_INTERVAL=30000

# =============================================================================
# COMPLIANCE & AUDITING
# =============================================================================

# Data Retention
EXTERNAL_API_DATA_RETENTION_DAYS=30
EXTERNAL_API_AUDIT_LOG_ENABLED=true
EXTERNAL_API_AUDIT_LOG_FILE=/var/log/aegrid/audit.log

# Privacy & Security
EXTERNAL_API_DATA_ENCRYPTION=true
EXTERNAL_API_PII_FILTERING=true
EXTERNAL_API_ACCESS_LOGGING=true
